# Build artifacts (machine-specific, recreated by nvcc / msbuild)
build/
*.o
*.so
*.exe
*.lib
*.exp
*.pdb
*.dll

# Python cache and virtual environments
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# Editor / IDE
.vscode/
.idea/
*.swp
*~
.DS_Store

# Office lock files (temp while a doc is open in Word/PowerPoint)
~$*

# Notebook outputs (uncomment if you want to strip them)
# notebooks/*.ipynb
